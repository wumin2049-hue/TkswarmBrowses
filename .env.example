# TkSwarm PHP API（桌面端登录用）
TKSWARM_API_BASE=http://127.0.0.1:8080/api

# 本地 Bit 兼容 API
TKSWARM_BROWSER_HOST=127.0.0.1
TKSWARM_BROWSER_PORT=54345

# 每账号最大环境数
TKSWARM_BROWSER_MAX_ENVS=300

# 同时运行的窗口上限（0=不限制；默认 20，防内存打爆）
TKSWARM_BROWSER_MAX_CONCURRENT=20

# 浏览器内核引擎：electron=自研本体承载窗口（默认）；chrome=拉起系统 Chrome
# 也可以写在 data/settings.json 的 "engine" 字段
# TKSWARM_BROWSER_ENGINE=electron

# 可选：自定义 Chrome 路径（仅 engine=chrome 时有用）
# TKSWARM_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 可选：自定义数据目录（便携版默认 exe 同级 data/；安装版默认 %APPDATA%\TkSwarmBrowser）
# TKSWARM_BROWSER_DATA=D:\TkSwarmBrowser\data

# 环境窗口渲染成纯白（显卡 / 远程桌面硬件合成问题）时，强制软件渲染（默认关，避免卡顿）
# 也可以写在 data/settings.json 的 "envSoftwareRender": true
# TKSWARM_ENV_SOFTWARE_RENDER=1

# 账号代理出网策略（默认 system=强制经本机 V2Ray/Clash 再连账号代理）
# system | auto（先直连失败再借道）| direct（绝不经本机翻墙）
# 也可写 data/settings.json："systemProxyMode": "system"
# TKSWARM_SYSTEM_PROXY_MODE=system
# TKSWARM_USE_SYSTEM_PROXY=1
# TKSWARM_NO_SYSTEM_PROXY=1
# TKSWARM_NO_SYSTEM_PROXY=1

# 性能：首屏后再做代理自检（毫秒，默认 25000）；burst 默认关
# TKSWARM_PROXY_PROBE_DELAY_MS=25000
# TKSWARM_PROXY_PROBE_BURST=1
# 指纹 ClientRects 补丁默认关（开了易卡 SPA）；需要时再开
# TKSWARM_FP_CLIENT_RECTS=1

# 环境窗口日志：<data>/logs/env-<环境ID>.log（排查空白窗口 / 加载失败用）
